flowchart TB

%% =========================================================
%% LEGACY OT ARCHITECTURE
%% =========================================================

%% ---------- ENTERPRISE ----------
subgraph ENT["Enterprise Network"]
    direction LR
    EU["Enterprise Users"]
    MW["Management Workstation<br/>Legacy Supervisory Access"]
end

%% ---------- REMOTE ACCESS ----------
subgraph REM["Remote Access"]
    direction LR
    RVA["Recognized Vendor<br/>Remote Access"]
    LVA["Legacy Vendor VPN<br/>Persistent Access Path"]
end

FW["Enterprise / OT<br/>Perimeter Firewall"]

%% ---------- SUPERVISORY OT ----------
subgraph OT["Legacy OT Environment<br/>Broadly Trusted BACnet/IP Network"]
    direction TB

    CORE["OT Network Backbone<br/>Switching / BACnet/IP"]

    subgraph SUP["Supervisory and Engineering Systems"]
        direction LR
        HMI1["Operator HMI 1"]
        HMI2["Operator HMI 2"]
        BAS["SCADA / BAS Server"]
        ENG["Engineering Workstation<br/>High Privilege"]
        HIST["OT Historian"]
    end

    subgraph CTRL["BACnet/IP Control Layer"]
        direction LR
        C1["Plant Controller 1<br/>Chiller Control"]
        C2["Plant Controller 2<br/>Pump / Distribution"]
        C3["Plant Controller 3<br/>Condenser / Tower Control"]
    end

    subgraph GATE["Legacy Field-Network Gateways"]
        direction LR
        R1["BACnet/IP ↔ MS/TP<br/>Router A"]
        R2["BACnet/IP ↔ MS/TP<br/>Router B"]
    end
end

%% ---------- LEGACY MS/TP ----------
subgraph MSTP_A["BACnet MS/TP Trunk A<br/>Chilled-Water Automatic Control Inputs"]
    direction LR
    A1["D/P Input"]
    A2["Supply RTD"]
    A3["Return RTD"]
    A4["Flow / Status"]
    A5["Legacy Field I/O"]
end

subgraph MSTP_B["BACnet MS/TP Trunk B<br/>Condenser / Cooling-Tower Automatic Control Inputs"]
    direction LR
    B1["D/P Input"]
    B2["Condenser RTD"]
    B3["Process RTD"]
    B4["Legacy Field I/O"]
end

%% ---------- PHYSICAL PROCESS ----------
subgraph PROC["Plant Process"]
    direction LR
    CH["Chillers"]
    PUMP["Pumps"]
    TOWER["Cooling Towers"]
    VFD["VFDs"]
    VALVE["Control Valves"]
end

%% ---------- MAINTENANCE ----------
subgraph MAINT["Local Maintenance Access"]
    direction LR
    CLAP["Company Maintenance Laptop"]
    VLAP["Vendor Service Laptop"]
end

%% ---------- DEGRADED / MANUAL OPERATION ----------
subgraph MAN["Local / Degraded Operation"]
    direction LR
    BOARD["Central Physical<br/>Control Board"]
    LOCAL["Local Equipment<br/>Controls"]
end

%% =========================================================
%% PRIMARY ARCHITECTURE FLOW
%% =========================================================

ENT --> FW
REM -. Remote connectivity .-> FW
FW --> CORE

CORE --> SUP
CORE --> CTRL

CTRL --> GATE
R1 --> MSTP_A
R2 --> MSTP_B

MSTP_A -. Process values .-> CTRL
MSTP_B -. Process values .-> CTRL

CTRL --> PROC

%% =========================================================
%% SUPERVISORY RELATIONSHIPS
%% =========================================================

HMI1 --> BAS
HMI2 --> BAS
ENG --> CORE
HIST --> CORE

%% =========================================================
%% REMOTE / LEGACY ACCESS
%% =========================================================

RVA -. Approved support path .-> CORE
LVA -. Legacy VPN path .-> CORE

%% =========================================================
%% MAINTENANCE PATHS
%% =========================================================

CLAP -. Direct service connection .-> CH
CLAP -. Direct service connection .-> VFD

VLAP -. Vendor service connection .-> CH
VLAP -. Vendor service connection .-> VFD

%% =========================================================
%% MANUAL / DEGRADED CONTROL
%% =========================================================

BOARD --> LOCAL
LOCAL --> PROC

%% =========================================================
%% STYLING
%% =========================================================

classDef enterprise fill:#eef4ff,stroke:#526d8c,stroke-width:1px;
classDef remote fill:#f6efff,stroke:#78579c,stroke-width:1px;
classDef perimeter fill:#f3f3f3,stroke:#555,stroke-width:2px;
classDef supervisory fill:#eef8ee,stroke:#5d805d,stroke-width:1px;
classDef controller fill:#f4f7e9,stroke:#77854e,stroke-width:1px;
classDef legacy fill:#edf5ff,stroke:#5277a5,stroke-width:1px;
classDef process fill:#fff7e8,stroke:#a6762e,stroke-width:1px;
classDef maintenance fill:#fff2e8,stroke:#a2693f,stroke-width:1px;
classDef manual fill:#f8f4e8,stroke:#887343,stroke-width:1px;
classDef warning fill:#fff0f0,stroke:#a74d4d,stroke-width:2px;

class EU,MW enterprise;
class RVA remote;
class LVA warning;
class FW perimeter;
class CORE,BAS,HMI1,HMI2,ENG,HIST supervisory;
class C1,C2,C3,R1,R2 controller;
class A1,A2,A3,A4,A5,B1,B2,B3,B4 legacy;
class CH,PUMP,TOWER,VFD,VALVE process;
class CLAP,VLAP maintenance;
class BOARD,LOCAL manual;
